# Copy to scripts/golive.env (git-ignored) and fill in. Never commit the filled-in file.
SUPABASE_PROJECT_REF=          # Supabase → Project Settings → General → Reference ID
APP_URL=                       # e.g. https://redcon-tender-planning.pages.dev
APP_TIMEZONE=Africa/Cairo
GEMINI_API_KEY=                # optional until Outlook is connected; free key from aistudio.google.com → Get API key
GEMINI_MODEL=gemini-3.8-flash  # free tier; gemini-3.5-flash-lite has higher free limits
COMPOSIO_API_KEY=              # optional until Outlook is connected; composio.dev → Settings → API key
COMPOSIO_CONNECTED_ACCOUNT_ID= # optional until Outlook is connected; starts with ca_
COMPOSIO_ARG_MAP=              # leave empty unless the Outlook tool argument names differ
ADMIN_NAME=
ADMIN_EMAIL=
VAPID_SUBJECT=                 # optional, defaults to mailto:ADMIN_EMAIL
SUPABASE_DB_URL=               # optional (Session pooler string); lets the script run the admin SQL itself
